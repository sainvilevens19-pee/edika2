generator client {
  provider        = "prisma-client-js"
  // multiSchema est GA dans Prisma 7 — pas besoin de previewFeatures
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Prisma 7 : déclaration explicite du schema PostgreSQL (multi-schema GA)
  schemas  = ["public"]
}

// ─── École ────────────────────────────────────────────────────────────────────

model School {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  city      String?
  phone     String?
  email     String?
  logo      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  students            Student[]
  teacherAssignments  TeacherAssignment[]
  academicYears       AcademicYear[]

  @@schema("public")
  @@map("schools")
}

// ─── Année scolaire ───────────────────────────────────────────────────────────

model AcademicYear {
  id        String   @id @default(uuid())
  schoolId  String
  label     String   // "2024-2025"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherAssignment[]

  @@unique([schoolId, label])
  @@schema("public")
  @@map("academic_years")
}

// ─── Utilisateur ──────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  // Null pour PARENT et TEACHER (pas encore assigné à une école)
  schoolId  String?
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  avatar    String?
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school          School?        @relation(fields: [schoolId], references: [id])
  studentProfile  Student?
  teacherProfile  Teacher?
  parentProfile   Parent?
  refreshTokens   RefreshToken[]

  @@schema("public")
  @@map("users")
}

enum Role {
  SUPER_ADMIN
  DIRECTOR
  CENSOR
  SECRETARY
  TEACHER
  STUDENT
  PARENT

  @@schema("public")
}

// ─── Token de rafraîchissement ────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
  @@map("refresh_tokens")
}

// ─── Élève ────────────────────────────────────────────────────────────────────

model Student {
  id            String    @id @default(uuid())
  userId        String    @unique
  schoolId      String
  dossierNumber String    @unique // Numéro de dossier utilisé par les parents pour lier leurs enfants
  dateOfBirth   DateTime?
  gender        Gender    @default(MALE)
  address       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  school  School          @relation(fields: [schoolId], references: [id])
  parents ParentStudent[]

  @@schema("public")
  @@map("students")
}

enum Gender {
  MALE
  FEMALE

  @@schema("public")
}

// ─── Parent ───────────────────────────────────────────────────────────────────

model Parent {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  children ParentStudent[]

  @@schema("public")
  @@map("parents")
}

// Lien Parent ↔ Élève
model ParentStudent {
  parentId     String
  studentId    String
  relationship Relationship @default(PARENT)
  linkedAt     DateTime     @default(now())

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@schema("public")
  @@map("parent_students")
}

enum Relationship {
  FATHER
  MOTHER
  GUARDIAN
  PARENT

  @@schema("public")
}

// ─── Professeur ───────────────────────────────────────────────────────────────

model Teacher {
  id             String   @id @default(uuid())
  userId         String   @unique
  specialization String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments TeacherAssignment[]

  @@schema("public")
  @@map("teachers")
}

// Affectation Professeur ↔ École / Année scolaire
// Un professeur peut être assigné à plusieurs écoles et années
model TeacherAssignment {
  id             String   @id @default(uuid())
  teacherId      String
  schoolId       String
  academicYearId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([teacherId, schoolId, academicYearId])
  @@schema("public")
  @@map("teacher_assignments")
}
